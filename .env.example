# Copia este archivo como .env.local para probar en tu computador.
# En Vercel, estas variables se ponen en Settings → Environment Variables.

# Obligatoria: tu API key de console.anthropic.com (nunca la subas a GitHub)
ANTHROPIC_API_KEY=

# Opcional: modelo a usar (por defecto Claude Haiku 4.5, el más económico)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Opcional: idioma de las respuestas de la IA ("es" o "en")
APP_LANG=es

# Opcional: almacenamiento para guardar los análisis y los límites de uso.
# Vercel las crea solas al conectar Upstash Redis desde Storage → Marketplace.
# Sin ellas, la app funciona igual pero guarda todo solo en memoria.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opcional: límites de uso para proteger el crédito de la API
CHAT_LIMIT_PER_HOUR=20
ANALYZE_LIMIT_PER_HOUR=30
DAILY_AI_CALLS_MAX=400
