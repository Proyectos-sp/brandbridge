# Copia este archivo como .env.local para probar en tu computador.
# En Vercel, estas variables se ponen en Settings → Environment Variables.
# Nunca subas tus API keys a GitHub.

# ---- IA: elige un proveedor ----
# "gemini" (tiene plan gratuito) o "claude" (de pago).
# Si no la pones, se usa Gemini cuando existe GEMINI_API_KEY.
AI_PROVIDER=gemini

# Gemini: crea la key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo principal y modelo de respaldo si el principal llega a su límite gratuito
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Claude (opcional): key de https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Idioma de toda la app y de la IA: "en" (inglés, por defecto) o "es" (español) ----
# Si lo cambias en Vercel, haz Redeploy para que se aplique.
APP_LANG=en

# ---- Almacenamiento (opcional pero recomendado) ----
# Vercel las crea solas al conectar Upstash Redis desde Storage → Marketplace.
# Sin ellas, la app funciona igual pero guarda los análisis solo en memoria.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Límites de uso (opcional) ----
CHAT_LIMIT_PER_HOUR=20
ANALYZE_LIMIT_PER_HOUR=30
# Investigaciones de empresas nuevas con IA (búsqueda en internet) por persona y hora
RESEARCH_LIMIT_PER_HOUR=5
DAILY_AI_CALLS_MAX=400
