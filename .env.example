# Copia este archivo como .env.local para probar en tu computador.
# En Vercel, estas variables se ponen en Settings → Environment Variables.
# Nunca subas tus API keys a GitHub.

# ---- IA: elige un proveedor ----
# "gemini" (tiene plan gratuito) o "claude" (de pago).
# Si no la pones, se usa Gemini cuando existe GEMINI_API_KEY.
AI_PROVIDER=gemini

# Gemini: crea la key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo principal y modelo de respaldo si el principal llega a su límite gratuito
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Más modelos para seguir cuando los anteriores agotan su cupo gratuito (cada uno tiene el suyo)
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# Cuánto puede "pensar" la IA antes de responder (tokens). Más alto = más lento. -1 = sin límite.
GEMINI_THINKING_BUDGET=512
# Investigar empresas con Google Search (solo plan pagado). Sin esto se usa el modo gratuito:
# la IA lee el sitio oficial y el artículo de Wikipedia de la empresa.
GEMINI_SEARCH=false

# Claude (opcional): key de https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Idioma con que abre la app: "en" (inglés, por defecto) o "es" (español) ----
# Cada visitante puede cambiarlo con el botón EN/ES de la cabecera (se recuerda en su navegador).
# Si lo cambias en Vercel, haz Redeploy para que se aplique.
APP_LANG=en

# ---- Almacenamiento (opcional pero recomendado) ----
# Vercel las crea solas al conectar Upstash Redis desde Storage → Marketplace.
# Sin ellas, la app funciona igual pero guarda los análisis solo en memoria.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Límites de uso (opcional) ----
CHAT_LIMIT_PER_HOUR=20
ANALYZE_LIMIT_PER_HOUR=30
# Investigaciones de empresas nuevas con IA (búsqueda en internet) por persona y hora
RESEARCH_LIMIT_PER_HOUR=5
DAILY_AI_CALLS_MAX=400

# ---- Panel privado de estadísticas: /admin ----
# Contraseña para entrar al panel (visitas, países, marcas más consultadas…). Sin ella, /admin no existe.
# Usa una larga y difícil; si la cambias, se cierran las sesiones abiertas.
ADMIN_PASSWORD=
# Zona horaria en que se cortan los días del panel (por defecto America/Panama).
STATS_TIMEZONE=America/Panama
